# Memorize For Life needs NO secrets to build, test, or run.
# Everything below is optional. Copy to `.env` (gitignored) only if you need it.

# Only for manual deploys with `npx wrangler pages deploy dist` (the normal
# flow is Cloudflare's Git integration, which needs no keys in this repo).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Use a system Chromium for Playwright instead of the bundled one.
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome-linux/chrome

# --- NIV lookup via API.Bible (optional) --------------------------------------------------------
# These are NOT read from this file: set them as SECRETS in Cloudflare
# (Pages project -> Settings -> Variables and Secrets -> Add -> type "Secret"). Local .env is only
# for `wrangler pages dev`. Never commit real values, and never paste a key into chat or an issue.
# API_BIBLE_KEY=            # from https://scripture.api.bible (your account dashboard)
# API_BIBLE_NIV_ID=         # optional: pin the Bible id instead of searching for "NIV"
