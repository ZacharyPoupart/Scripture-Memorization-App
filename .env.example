# Memorize For Life needs NO secrets to build, test, or run.
# Everything below is optional. Copy to `.env` (gitignored) only if you need it.

# Only for manual deploys with `npx wrangler pages deploy dist` (the normal
# flow is Cloudflare's Git integration, which needs no keys in this repo).
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=

# Use a system Chromium for Playwright instead of the bundled one.
# PW_CHROMIUM_PATH=/opt/pw-browsers/chromium/chrome-linux/chrome
