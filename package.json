{
  "name": "memorize-for-life",
  "version": "1.5.1",
  "private": true,
  "type": "module",
  "description": "Memorize For Life: spaced-repetition Bible verse memorization PWA",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm run test && npm run build && npm run test:e2e",
    "gen:icons": "node scripts/gen-icons.mjs",
    "gen:versification": "node scripts/gen-versification.mjs",
    "release": "node scripts/release.mjs bump",
    "dev:lan": "vite --host 0.0.0.0 --port 5173",
    "preview:lan": "npm run build && vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
    "preact": "^11.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}
